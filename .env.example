# MeLi OAuth App Credentials
MELI_APP_ID=your_app_id
MELI_SECRET_KEY=your_secret_key
MELI_REDIRECT_URI=http://localhost:8000/auth/meli/callback

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://meli:meli@localhost:5432/melioptimizer
DATABASE_URL_SYNC=postgresql://meli:meli@localhost:5432/melioptimizer

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-string
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-key

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
